{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acceptance",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/dev-acceptance.ts"],
      "cwd": "apps/web",
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/mobile", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
