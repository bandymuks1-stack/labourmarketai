,  ('account_classifications',             'profile_id',              'profile', 'c', 'DELETE',      'cascade', 'classification of the erased account itself')
,  ('agencies',                            'profile_id',              'profile', 'n', 'PSEUDONYMISE', 'null',   'organization record outlives the person (registry: organization record)')
,  ('agency_candidate_offers',             'created_by',              'profile', 'n', 'PSEUDONYMISE', 'null',   'actor on an agency''s offer')
,  ('agency_candidate_offers',             'decided_by',              'profile', 'n', 'PSEUDONYMISE', 'null',   'actor')
,  ('agency_candidate_offers',             'withdrawn_by',            'profile', 'n', 'PSEUDONYMISE', 'null',   'actor')
