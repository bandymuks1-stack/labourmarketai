-- ── 5. CHECK amendments (8) — the actor may be NULL once the person erased ──
-- Each keeps its original shape and only stops requiring the actor id; the
-- stamp (…_at / decision) still proves the event happened. Added NOT VALID
-- then VALIDATEd: the new predicate is strictly weaker, so validation cannot
-- fail on existing rows.

alter table public.workflow_instance_approvers drop constraint if exists workflow_instance_approvers_decided_shape;
alter table public.workflow_instance_approvers add constraint workflow_instance_approvers_decided_shape check (
  ((decision is null) and (decided_by is null) and (decided_at is null))
  or ((decision is not null) and (decided_at is not null))
) not valid;
alter table public.workflow_instance_approvers validate constraint workflow_instance_approvers_decided_shape;

alter table public.onboarding_run_items drop constraint if exists onboarding_run_items_done_shape;
alter table public.onboarding_run_items add constraint onboarding_run_items_done_shape check (
  ((status = 'pending') and (completed_by is null) and (completed_at is null))
  or ((status = any (array['done','skipped'])) and (completed_at is not null))
) not valid;
alter table public.onboarding_run_items validate constraint onboarding_run_items_done_shape;

alter table public.offboarding_run_items drop constraint if exists offboarding_run_items_done_shape;
alter table public.offboarding_run_items add constraint offboarding_run_items_done_shape check (
  ((status = 'pending') and (completed_by is null) and (completed_at is null))
  or ((status = any (array['done','skipped'])) and (completed_at is not null))
) not valid;
alter table public.offboarding_run_items validate constraint offboarding_run_items_done_shape;

alter table public.performance_reviews drop constraint if exists performance_reviews_manager_input_stamp;
alter table public.performance_reviews add constraint performance_reviews_manager_input_stamp check (
  ((manager_input is null) = (manager_input_at is null))
  and ((manager_input_by is null) or (manager_input is not null))
) not valid;
alter table public.performance_reviews validate constraint performance_reviews_manager_input_stamp;

alter table public.organization_claims drop constraint if exists organization_claims_decision_complete;
alter table public.organization_claims add constraint organization_claims_decision_complete check (
  (state <> all (array['representative_verified','linked']))
  or ((decided_at is not null) and (verification_method is not null) and (verification_evidence_ref is not null))
) not valid;
alter table public.organization_claims validate constraint organization_claims_decision_complete;

alter table public.work_counterparty_links drop constraint if exists work_counterparty_links_revocation_shape;
alter table public.work_counterparty_links add constraint work_counterparty_links_revocation_shape check (
  (revoked_by is null) or (revoked_at is not null)
) not valid;
alter table public.work_counterparty_links validate constraint work_counterparty_links_revocation_shape;

alter table public.document_acknowledgements drop constraint if exists document_acknowledgements_stamp_pair;
alter table public.document_acknowledgements add constraint document_acknowledgements_stamp_pair check (
  (acknowledged_by is null) or (acknowledged_at is not null)
) not valid;
alter table public.document_acknowledgements validate constraint document_acknowledgements_stamp_pair;

-- invitations: a third origin shape "inviter erased" — no inviter, no external
-- source, and never still pending (execute_v2 revokes pending ones first).
alter table public.invitations drop constraint if exists invitations_origin_chk;
alter table public.invitations add constraint invitations_origin_chk check (
  ((inviter_profile_id is not null) and (external_source_slug is null) and (external_reference is null))
  or ((inviter_profile_id is null) and (external_source_slug is not null) and (external_reference is not null) and (consent_record is not null))
  or ((inviter_profile_id is null) and (external_source_slug is null) and (external_reference is null) and (status <> 'pending'))
) not valid;
alter table public.invitations validate constraint invitations_origin_chk;

-- ── 6. registry seed (264 FK columns, production 2026-10-15) + 2 no-FK ──────
