-- @human-gate-approved  (acknowledgement only: PR is DRAFT + needs-human-gate; prod apply waits for the owner)
-- 20261016090000 — privacy erasure executor v2 (#856; supersedes the unmerged #2412 draft)
--
-- DRAFT. NOT APPLIED. RED class: SECURITY DEFINER, 99 NOT NULL relaxations,
-- 8 CHECK amendments, trigger-function change on the consent ledger, and
-- destructive DML behind service_role-only RPCs. Design: DESIGN.md (same PR).
--
-- WHAT THIS DOES (and what it deliberately does NOT do)
--   * ERASURE (rows deleted) and PSEUDONYMISATION (rows kept, link removed,
--     identifiers scrubbed) are two different outcomes. Every foreign key that
--     references public.profiles / public.workers / auth.users in production
--     (264 measured 2026-10-15) is classified in the registry table
--     public.privacy_erasure_relations as DELETE, PSEUDONYMISE, RETAIN
--     (retain-detached under a stated legal hold) or BLOCK (manual resolution).
--     A new FK that is not in the registry makes every erasure REFUSE until it
--     is classified (drift guard).
--   * prepare_v2 = dry run: counts per relation and action, blockers, storage
--     objects; it writes only the job row.
--   * execute_v2 = one transaction: detach / scrub / delete, delete the
--     workers and profiles rows, return the Storage object list. It NEVER
--     deletes auth.users and NEVER deletes Storage files (SQL cannot delete
--     the bytes): the server deletes the objects through the Storage API,
--     calls storage_done_v2, then auth.admin.deleteUser, then complete_v2.
--   * Nothing returns or stores an identifier that links the erased person to
--     what remains: the consent-ledger tombstone is minted inside execute_v2
--     and never returned; erased_at is coarse (month); the job row drops the
--     subject id at completion and keeps only aggregate counts + coarse dates.
--
-- Rollback: supabase/rollbacks/20261016090000_privacy_erasure_executor_v2.down.sql

begin;

-- ── 0. supersede the unmerged v1 draft (#2412) ──────────────────────────────
-- v1 deleted auth.users in SQL (bypasses the Auth Admin API and Storage
-- ownership) and returned the tombstone. Neither survives into v2.
drop function if exists public.erase_user_account_v1(uuid);

-- ── 1. job / state table (service_role read only; written by the RPCs) ──────
create table if not exists public.privacy_erasure_jobs (
  id               uuid primary key default gen_random_uuid(),
  -- the reviewed account_deletion request; that row is itself RETAINED
  -- detached for 3 years (E4), so this link names no person after completion
  request_id       uuid references public.customer_requests(id) on delete set null,
  -- present ONLY while the job is open; nulled by complete_v2
  subject_user_id  uuid,
  state            text not null default 'prepared'
                   check (state in ('prepared','blocked','failed','storage_pending',
                                    'auth_pending','completed','cancelled')),
  blockers         jsonb not null default '[]'::jsonb,
  report           jsonb not null default '{}'::jsonb,   -- aggregate counts only
  storage_ops      jsonb,                                -- object paths; nulled at completion
  attempts         integer not null default 0,
  last_error       text,                                 -- sqlstate + table + constraint, never values
  created_on       date not null default current_date,   -- coarse dates only
  executed_on      date,
  completed_on     date,
  constraint privacy_erasure_jobs_subject_open check (
    (state in ('completed','cancelled')) = (subject_user_id is null)
  )
);

create unique index if not exists privacy_erasure_jobs_one_open
  on public.privacy_erasure_jobs (subject_user_id)
  where subject_user_id is not null;

alter table public.privacy_erasure_jobs enable row level security;
revoke all on public.privacy_erasure_jobs from public, anon, authenticated;
grant select on public.privacy_erasure_jobs to service_role;

comment on table public.privacy_erasure_jobs is
  'GDPR Art. 17 erasure jobs (#856 v2). One open job per subject. After completion the row holds no subject id, no paths, only aggregate counts and coarse dates.';

-- ── 2. classification registry (one row per FK column onto a person) ────────
create table if not exists public.privacy_erasure_relations (
  table_name    text not null,
  column_name   text not null,
  ref_kind      text not null check (ref_kind in ('profile','worker','auth','none')),
  fk_on_delete  text not null,           -- pg confdeltype at classification time: a n c r, '-' = no FK
  class         text not null check (class in ('DELETE','PSEUDONYMISE','RETAIN','BLOCK')),
  mode          text not null check (mode in ('cascade','delete','null','special','none')),
  note          text not null,
  primary key (table_name, column_name)
);

alter table public.privacy_erasure_relations enable row level security;
revoke all on public.privacy_erasure_relations from public, anon, authenticated;
grant select on public.privacy_erasure_relations to service_role;

comment on table public.privacy_erasure_relations is
  'Every column that references a person, classified for erasure: DELETE / PSEUDONYMISE / RETAIN (detached, legal hold) / BLOCK. An FK onto profiles/workers missing here blocks every erasure.';

-- ── 3. consent ledger: #2412 detach columns (idempotent) ────────────────────
alter table public.privacy_consent_events
  add column if not exists erased_subject_id uuid,
  add column if not exists erased_at timestamptz;

alter table public.privacy_consent_events drop constraint if exists pce_subject_attached_or_detached;
alter table public.privacy_consent_events add constraint pce_subject_attached_or_detached check (
  (user_id is not null and erased_subject_id is null and erased_at is null)
  or (user_id is null and erased_subject_id is not null and erased_at is not null)
);

comment on column public.privacy_consent_events.erased_subject_id is
  'Random uuid minted inside privacy_erasure_execute_v2 per erasure; groups one former subject''s rows so grant/withdraw pairs stay provable; never returned, never stored anywhere else.';
comment on column public.privacy_consent_events.erased_at is
  'Month of erasure (date_trunc month) - deliberately coarse so it cannot be joined to other rows.';

create or replace function public.privacy_ledger_block_mutation()
returns trigger
language plpgsql
set search_path = ''
as $$
declare
  v_subject text := nullif(current_setting('lm.privacy_erasure_subject', true), '');
begin
  -- The ONE permitted mutation: the sanctioned erasure detach of the
  -- consent ledger (#856). DELETE stays refused for every role.
  if tg_op = 'UPDATE'
    and tg_table_name = 'privacy_consent_events'
    and v_subject is not null
    and old.user_id is not null
    and old.user_id::text = v_subject
    and old.erased_subject_id is null
    and new.user_id is null
    and new.erased_subject_id is not null
    and new.erased_at is not null
    and (to_jsonb(new) - 'user_id' - 'erased_subject_id' - 'erased_at')
        = (to_jsonb(old) - 'user_id' - 'erased_subject_id' - 'erased_at')
  then
    return new;
  end if;
  raise exception 'privacy ledger is append-only: % on % is not allowed', tg_op, tg_table_name
    using errcode = 'raise_exception';
end;
$$;

-- ── 4. NOT NULL relaxations (99) ────────────────────────────────────────────
-- Each column below is classified PSEUDONYMISE / RETAIN (or BLOCK-then-RETAIN):
-- the row survives the erasure and the link to the erased person becomes NULL.
-- A NULL actor means "a person who has since erased their account". FK
-- columns cannot carry a random per-erasure id (it would violate the FK), and
-- a shared sentinel profile would need a fake auth user; NULL stores nothing.
-- Two of them (agency_client_connections.invited_by,
-- agency_client_request_shares.shared_by) are ON DELETE SET NULL + NOT NULL
-- today, i.e. already a latent erasure blocker.
alter table public.agency_client_connections alter column invited_by drop not null;
alter table public.agency_client_request_shares alter column shared_by drop not null;
alter table public.agency_worker_invitations alter column inviter_profile_id drop not null;
