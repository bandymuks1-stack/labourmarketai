,  ('company_worker_invitations',          'inviter_profile_id',      'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('company_workers',                     'worker_id',               'worker', 'c', 'BLOCK',       'cascade', 'BLOCK while status=''active'' (end_roster_link_v1); then DELETE by cascade')
