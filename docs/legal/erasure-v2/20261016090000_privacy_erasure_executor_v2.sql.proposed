,  ('work_tasks',                          'assignee_profile_id',     'profile', 'n', 'PSEUDONYMISE', 'null',   'actor')
,  ('work_tasks',                          'created_by',              'profile', 'c', 'PSEUDONYMISE', 'null',   'G2')
,  ('worker_absences',                     'requested_by',            'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_absences',                     'reviewed_by',             'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_absences',                     'worker_id',               'worker', 'c', 'RETAIN',      'special', 'absence fact = working-time record; private reason (note) scrubbed')
,  ('worker_achievements',                 'profile_id',              'profile', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_document_events',              'actor_id',                'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_documents',                    'updated_by',              'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_documents',                    'verified_by',             'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_documents',                    'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own documents + files (E5); employer copy duty = Q4')
,  ('worker_education',                    'profile_id',              'profile', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_external_profiles',            'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_languages',                    'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_opportunity_seen',             'profile_id',              'profile', 'c', 'DELETE',      'cascade', 'own read marker')
,  ('worker_professions',                  'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_saved_opportunities',          'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_saved_searches',               'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('worker_skills',                       'verified_by',             'profile', 'a', 'PSEUDONYMISE', 'null',   'actor')
,  ('worker_skills',                       'worker_id',               'worker', 'c', 'DELETE',      'cascade', 'own content')
,  ('workers',                             'profile_id',              'profile', 'c', 'DELETE',      'special', 'deleted in SQL after retained children are detached')
,  ('workflow_definition_versions',        'created_by',              'profile', 'c', 'PSEUDONYMISE', 'null',   'G2')
,  ('workflow_definitions',                'created_by',              'profile', 'c', 'PSEUDONYMISE', 'null',   'G2')
,  ('workflow_instance_approvers',         'approver_profile_id',     'profile', 'c', 'PSEUDONYMISE', 'null',   'approver slot on someone else''s workflow')
,  ('workflow_instance_approvers',         'decided_by',              'profile', 'a', 'PSEUDONYMISE', 'null',   'actor; CHECK amended')
,  ('workflow_instance_approvers',         'delegated_to_profile_id', 'profile', 'n', 'PSEUDONYMISE', 'null',   'actor')
,  ('workflow_instances',                  'requester_profile_id',    'profile', 'c', 'RETAIN',      'null',   'HR workflow record (e.g. leave) with append-only transitions - legal basis to confirm')
,  ('workflow_transitions',                'actor_profile_id',        'profile', 'a', 'PSEUDONYMISE', 'null',   'actor (append-only)')
,  ('company_worker_engagements',           'subject_key',             'none',    '-', 'PSEUDONYMISE', 'special', 'G4: no FK; per-row random key RE-MINTED at erasure so no pre-erasure copy can be joined')
,  ('worker_display_name_backfill_20260805', 'profile_id',              'none',    '-', 'DELETE',      'special', 'G4: one-off migration artifact holding before/after names')
on conflict (table_name, column_name) do update
  set ref_kind = excluded.ref_kind, fk_on_delete = excluded.fk_on_delete,
      class = excluded.class, mode = excluded.mode, note = excluded.note;

-- ── 7. helpers (internal; no grant to any API role) ─────────────────────────

-- Remove, recursively, every JSON string equal to one of p_ids and every key
-- named in p_drop_keys. Used on audit payloads, event before/after states and
-- metadata of rows that SURVIVE the erasure.
create or replace function public.privacy_erasure_scrub_jsonb(p jsonb, p_ids text[], p_drop_keys text[] default '{}')
returns jsonb
language plpgsql
immutable
set search_path = ''
as $$
begin
  if p is null then
    return null;
  elsif jsonb_typeof(p) = 'object' then
    return coalesce((
      select jsonb_object_agg(e.key, public.privacy_erasure_scrub_jsonb(e.value, p_ids, p_drop_keys))
        from jsonb_each(p) e
       where not (e.key = any (p_drop_keys))
         and not (jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') = any (p_ids))
    ), '{}'::jsonb);
  elsif jsonb_typeof(p) = 'array' then
    return coalesce((
      select jsonb_agg(public.privacy_erasure_scrub_jsonb(a.value, p_ids, p_drop_keys) order by a.ord)
        from jsonb_array_elements(p) with ordinality as a(value, ord)
       where not (jsonb_typeof(a.value) = 'string' and (a.value #>> '{}') = any (p_ids))
    ), '[]'::jsonb);
  end if;
  return p;
end;
$$;

-- The guard triggers execute_v2 must suspend for the length of its own
-- transaction: every enabled, non-internal UPDATE/DELETE trigger on a
-- registry table or on any table reachable from one by an ON DELETE
-- CASCADE / SET NULL / SET DEFAULT chain. Two are never suspended:
--   * privacy_consent_events_append_only — opened only by its own GUC detach;
--   * company_memberships.protect_last_owner — the last-owner rule is a
--     BLOCK, never bypassed.
-- Suspending the set_updated_at-style triggers is deliberate: a shared
-- updated_at = now() on every touched row would itself re-link the erased
-- person's rows across tables.
create or replace function public.privacy_erasure_guard_triggers_v2()
returns table (rel regclass, tgname name)
language sql
stable
set search_path = ''
as $$
  with recursive reach(oid) as (
    select c.oid
      from public.privacy_erasure_relations r
      join pg_catalog.pg_class c on c.relname = r.table_name
      join pg_catalog.pg_namespace n on n.oid = c.relnamespace and n.nspname = 'public'
    union
    select k.conrelid
      from pg_catalog.pg_constraint k
      join reach on k.confrelid = reach.oid
     where k.contype = 'f' and k.confdeltype in ('c','n','d')
  )
  select t.tgrelid::regclass, t.tgname
    from pg_catalog.pg_trigger t
    join reach on reach.oid = t.tgrelid
    join pg_catalog.pg_class c on c.oid = t.tgrelid
    join pg_catalog.pg_namespace n on n.oid = c.relnamespace and n.nspname = 'public'
   where not t.tgisinternal
     and t.tgenabled <> 'D'
     and (t.tgtype & (8 | 16)) <> 0
     and t.tgname not in ('privacy_consent_events_append_only', 'protect_last_owner')
   order by 1, 2;
$$;

-- Every reason the erasure may NOT run yet. Each blocker is resolved by a
-- human through the canonical product path, never worked around here.
create or replace function public.privacy_erasure_blockers_v2(p_user uuid)
returns jsonb
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  v_workers uuid[];
  v_out jsonb := '[]'::jsonb;
  v_n bigint;
begin
  select coalesce(array_agg(w.id), '{}') into v_workers from public.workers w where w.profile_id = p_user;

  -- B0: a reviewed, approved account_deletion request bound to this account
  if not exists (
    select 1 from public.customer_requests cr
     where cr.profile_id = p_user
       and cr.payload->>'source' = 'privacy_self_service'
       and cr.payload->>'privacy_request_type' = 'account_deletion'
       and cr.status = 'approved'
  ) then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','no_approved_deletion_request'));
  end if;

  -- B1: drift guard — an FK onto profiles/workers nobody has classified
  select count(*) into v_n
    from pg_catalog.pg_constraint k
    join pg_catalog.pg_class c on c.oid = k.conrelid
    join pg_catalog.pg_namespace n on n.oid = c.relnamespace
    join pg_catalog.pg_attribute a on a.attrelid = k.conrelid and a.attnum = k.conkey[1]
   where k.contype = 'f'
     and k.confrelid in ('public.profiles'::regclass, 'public.workers'::regclass)
     and not exists (select 1 from public.privacy_erasure_relations r
                      where r.table_name = c.relname and r.column_name = a.attname and n.nspname = 'public');
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','unclassified_relation','count',v_n));
  end if;

  -- B2: last active owner of an organization
  select count(*) into v_n from public.company_memberships m
   where m.profile_id = p_user and m.role = 'owner' and m.status = 'active'
     and not exists (select 1 from public.company_memberships o
                      where o.organization_id = m.organization_id and o.role = 'owner'
                        and o.status = 'active' and o.id <> m.id);
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','last_active_owner','count',v_n,
      'resolve','transfer ownership or close the organization (organization-closure runbook)'));
  end if;

  -- B3: active roster links
  select (select count(*) from public.company_workers x where x.worker_id = any (v_workers) and x.status = 'active')
       + (select count(*) from public.agency_workers  x where x.worker_id = any (v_workers) and x.status = 'active')
    into v_n;
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','active_roster_link','count',v_n,
      'resolve','end_roster_link_v1(..., ''account_deletion'')'));
  end if;

  -- B4: active employment-type engagement contexts
  select count(*) into v_n from public.engagement_contexts e
   where e.profile_id = p_user and e.status = 'active' and e.organization_id is not null;
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','active_engagement','count',v_n,
      'resolve','end_org_membership_v1(engagement_id, ''account_deletion'')'));
  end if;

  -- B5: open bookings / active company engagements
  select (select count(*) from public.booking_requests b where b.worker_id = any (v_workers) and b.status = 'proposed')
       + (select count(*) from public.company_worker_engagements e where e.worker_id = any (v_workers) and e.status = 'active')
    into v_n;
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','open_booking_or_engagement','count',v_n,
      'resolve','decline/withdraw the booking, end the engagement'));
  end if;

  -- B6: undecided payroll
  select count(*) into v_n from public.timesheets t where t.worker_id = any (v_workers) and t.status = 'submitted';
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','undecided_timesheet','count',v_n,
      'resolve','the employer approves or rejects the submitted timesheet'));
  end if;

  -- B7: open financial obligations
  select (select count(*) from public.billing_subscriptions s where s.owner_id = p_user
           and s.status in ('trialing','active','past_due','unpaid','incomplete'))
       + (select count(*) from public.subscriptions s where s.profile_id = p_user
           and s.status in ('trial','active','past_due'))
    into v_n;
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','open_subscription','count',v_n,
      'resolve','cancel at the payment provider; settle open invoices'));
  end if;

  -- B8: immutable credit ledger (no detach path is designed: manual decision)
  select (select count(*) from public.lmc_accounts a where a.profile_id = p_user)
       + (select count(*) from public.lmc_transactions t where t.actor_profile_id = p_user)
    into v_n;
  if v_n > 0 then
    v_out := v_out || jsonb_build_array(jsonb_build_object('code','credit_ledger','count',v_n,
      'resolve','owner + accountant decide; no automated path'));
  end if;

  return v_out;
end;
$$;

-- ── 8. prepare (dry run) ────────────────────────────────────────────────────
create or replace function public.privacy_erasure_prepare_v2(p_user uuid)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_workers uuid[];
  v_counts jsonb := '{}'::jsonb;
  v_storage jsonb;
  v_blockers jsonb;
  v_request uuid;
  v_job uuid;
  v_state text;
  v_n bigint;
  r record;
begin
  if p_user is null then
    raise exception 'privacy_erasure_prepare_v2: user id is required' using errcode = '22023';
  end if;
  if not exists (select 1 from auth.users u where u.id = p_user) then
    raise exception 'privacy_erasure_prepare_v2: no such user' using errcode = 'P0002';
  end if;

  select coalesce(array_agg(w.id), '{}') into v_workers from public.workers w where w.profile_id = p_user;

  for r in
    select x.* from public.privacy_erasure_relations x
      join pg_catalog.pg_class c on c.relname = x.table_name
      join pg_catalog.pg_namespace n on n.oid = c.relnamespace and n.nspname = 'public'
     where x.ref_kind in ('profile','worker','auth')
     order by x.table_name, x.column_name
  loop
    execute format('select count(*) from public.%I where %I = any ($1)', r.table_name, r.column_name)
      into v_n
      using case when r.ref_kind = 'worker' then v_workers else array[p_user] end;
    if v_n > 0 then
      v_counts := v_counts || jsonb_build_object(r.table_name || '.' || r.column_name,
                    jsonb_build_object('class', r.class, 'rows', v_n));
    end if;
  end loop;

  select coalesce(jsonb_object_agg(s.bucket_id, s.n), '{}'::jsonb) into v_storage
    from (select o.bucket_id, count(*) n from storage.objects o
           where o.owner_id = p_user::text
              or (o.bucket_id in ('profile-avatars','journal-entry-photos','customer-request-attachments')
                  and split_part(o.name, '/', 1) = p_user::text)
              or (o.bucket_id = 'conversation-attachments' and split_part(o.name, '/', 2) = p_user::text)
              or (o.bucket_id = 'document-files' and split_part(o.name, '/', 1) = 'worker'
                  and split_part(o.name, '/', 2) = any (select w::text from unnest(v_workers) w))
           group by o.bucket_id) s;

  v_blockers := public.privacy_erasure_blockers_v2(p_user);
  v_state := case when jsonb_array_length(v_blockers) > 0 then 'blocked' else 'prepared' end;

  select cr.id into v_request from public.customer_requests cr
   where cr.profile_id = p_user
     and cr.payload->>'source' = 'privacy_self_service'
     and cr.payload->>'privacy_request_type' = 'account_deletion'
     and cr.status = 'approved'
   order by cr.created_at desc limit 1;

  select j.id into v_job from public.privacy_erasure_jobs j where j.subject_user_id = p_user for update;
  if v_job is null then
    insert into public.privacy_erasure_jobs (request_id, subject_user_id, state, blockers, report)
    values (v_request, p_user, v_state, v_blockers, jsonb_build_object('dry_run', v_counts, 'storage', v_storage))
    returning id into v_job;
  else
    update public.privacy_erasure_jobs j
       set request_id = coalesce(v_request, j.request_id),
           state = case when j.state in ('storage_pending','auth_pending') then j.state else v_state end,
           blockers = v_blockers,
           report = j.report || jsonb_build_object('dry_run', v_counts, 'storage', v_storage)
     where j.id = v_job
    returning j.state into v_state;
  end if;

  return jsonb_build_object('job_id', v_job, 'state', v_state, 'request_found', v_request is not null,
                            'blockers', v_blockers, 'counts', v_counts, 'storage', v_storage);
end;
$$;

-- ── 9. execute (one transaction; never touches auth.users or Storage bytes) ─
create or replace function public.privacy_erasure_execute_v2(p_user uuid, p_job uuid)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_job       public.privacy_erasure_jobs%rowtype;
  v_blockers  jsonb;
  v_workers   uuid[];
  v_ids       text[];          -- the subject's identifiers as text: profile id + worker ids
  v_like      text[];          -- '%<id>%' patterns for jsonb/text sweeps
  v_email     text;
  v_tomb      uuid := gen_random_uuid();          -- consent-ledger grouping; NEVER returned or copied
  v_month     timestamptz := date_trunc('month', now());
  v_keep      uuid[];          -- journal entries retained as detached evidence
  v_more      uuid[];
  v_ctx       uuid[];          -- engagement contexts retained detached
  v_kept_req  uuid[];          -- customer_requests retained (privacy row / org demand / referenced)
  v_storage   jsonb := '[]'::jsonb;
  v_counts    jsonb := '{}'::jsonb;
  v_n         bigint;
  v_to        text;
  v_ext       text;
  v_trg       record;
  v_dis_rel   regclass[] := '{}';
  v_dis_tg    name[] := '{}';
  i           integer;
  r           record;
  v_sqlstate  text;
  v_table     text;
  v_constraint text;
begin
  if p_user is null or p_job is null then
    raise exception 'privacy_erasure_execute_v2: user and job are required' using errcode = '22023';
  end if;

  select * into v_job from public.privacy_erasure_jobs j where j.id = p_job for update;
  if not found then
    raise exception 'privacy_erasure_execute_v2: no such job' using errcode = 'P0002';
  end if;
  if v_job.subject_user_id is distinct from p_user then
    raise exception 'privacy_erasure_execute_v2: job does not belong to this subject' using errcode = '42501';
  end if;

  -- idempotent replay: the DB part already ran; hand back the same storage list
  if v_job.state in ('storage_pending','auth_pending') then
    return jsonb_build_object('job_id', v_job.id, 'state', v_job.state, 'replayed', true,
                              'storage_ops', coalesce(v_job.storage_ops, '[]'::jsonb));
  end if;
  if v_job.state not in ('prepared','blocked','failed') then
    raise exception 'privacy_erasure_execute_v2: job state % cannot execute', v_job.state using errcode = '55000';
  end if;
  if not exists (select 1 from auth.users u where u.id = p_user) then
    raise exception 'privacy_erasure_execute_v2: no such user' using errcode = 'P0002';
  end if;

  v_blockers := public.privacy_erasure_blockers_v2(p_user);
  if jsonb_array_length(v_blockers) > 0 then
    update public.privacy_erasure_jobs set state = 'blocked', blockers = v_blockers, attempts = attempts + 1
     where id = p_job;
    return jsonb_build_object('job_id', p_job, 'state', 'blocked', 'blockers', v_blockers);
  end if;

  begin  -- everything below is atomic: any error rolls back to here and marks the job failed
    perform set_config('lock_timeout', '5s', true);

    select coalesce(array_agg(w.id), '{}') into v_workers from public.workers w where w.profile_id = p_user;
    v_ids  := array[p_user::text] || coalesce((select array_agg(w::text) from unnest(v_workers) w), '{}');
    v_like := (select array_agg('%' || x || '%') from unnest(v_ids) x);
    select lower(nullif(btrim(coalesce(p.email, u.email)), '')) into v_email
      from auth.users u left join public.profiles p on p.id = u.id where u.id = p_user;

    -- 9.1 suspend guard triggers for THIS transaction only (re-enabled in 9.9)
    for v_trg in select * from public.privacy_erasure_guard_triggers_v2() loop
      execute format('alter table %s disable trigger %I', v_trg.rel, v_trg.tgname);
      v_dis_rel := v_dis_rel || v_trg.rel;
      v_dis_tg  := v_dis_tg  || v_trg.tgname;
    end loop;

    -- 9.2 decide what is retained BEFORE anything is removed
    -- journal entries: employer-confirmed / submitted for review / feeding hours
    select coalesce(array_agg(je.id), '{}') into v_keep
      from public.journal_entries je
     where je.worker_id = any (v_workers)
       and (exists (select 1 from public.journal_entry_confirmations c where c.entry_id = je.id)
         or exists (select 1 from public.journal_entry_review_submissions s
                     where s.entry_id = je.id or s.resubmission_of_entry_id = je.id)
         or exists (select 1 from public.work_hour_allocations h where h.journal_entry_id = je.id));
    loop  -- close over correction / supersession chains (NO ACTION self references)
      select coalesce(array_agg(distinct x.id), '{}') into v_more from (
        select je.correction_of as id from public.journal_entries je where je.id = any (v_keep) and je.correction_of is not null
        union select je.superseded_by from public.journal_entries je where je.id = any (v_keep) and je.superseded_by is not null
        union select je.id from public.journal_entries je where je.correction_of = any (v_keep) or je.superseded_by = any (v_keep)
      ) x where not (x.id = any (v_keep));
      exit when cardinality(v_more) = 0;
      v_keep := v_keep || v_more;
    end loop;

    select coalesce(array_agg(distinct x.id), '{}') into v_ctx from (
      select je.engagement_context_id as id from public.journal_entries je where je.id = any (v_keep)
      union select c.confirmer_engagement_context_id from public.journal_entry_confirmations c where c.confirmer_id = p_user
      union select e.id from public.engagement_contexts e where e.profile_id = p_user and e.organization_id is not null
    ) x;

    select coalesce(array_agg(cr.id), '{}') into v_kept_req
      from public.customer_requests cr
     where cr.profile_id = p_user
       and (cr.payload->>'source' = 'privacy_self_service'
         or cr.organization_id is not null or cr.agency_client_id is not null
         or exists (select 1 from public.booking_requests b where b.request_id = cr.id)
         or exists (select 1 from public.invitations i where i.target_request_id = cr.id)
         or exists (select 1 from public.team_demand_offers t where t.request_id = cr.id)
         or exists (select 1 from public.agency_candidate_offers a where a.request_id = cr.id)
         or exists (select 1 from public.commercial_handoffs h where h.request_id = cr.id));

    -- 9.3 storage plan (paths are captured while the owning rows still exist)
    select coalesce(jsonb_agg(jsonb_build_object('bucket', o.bucket_id, 'path', o.name, 'op', 'delete')
                              order by o.bucket_id, o.name), '[]'::jsonb)
      into v_storage
      from storage.objects o
     where (o.bucket_id in ('profile-avatars','journal-entry-photos') and split_part(o.name, '/', 1) = p_user::text)
        or (o.bucket_id = 'conversation-attachments' and split_part(o.name, '/', 2) = p_user::text)
        or (o.bucket_id = 'document-files' and split_part(o.name, '/', 1) = 'worker' and split_part(o.name, '/', 2) = any (v_ids))
        or (o.bucket_id = 'customer-request-attachments' and split_part(o.name, '/', 1) = p_user::text
            and not exists (select 1 from public.customer_request_attachments a
                             where a.storage_path = o.name and a.request_id = any (v_kept_req)));

    for r in select a.id, a.storage_path, a.file_name from public.customer_request_attachments a
              where a.profile_id = p_user and a.request_id = any (v_kept_req) loop
      v_ext := coalesce('.' || lower(substring(r.file_name from '\.([A-Za-z0-9]{1,8})$')), '');
      v_to  := 'erased/' || gen_random_uuid()::text || v_ext;
      v_storage := v_storage || jsonb_build_array(jsonb_build_object(
                     'bucket', 'customer-request-attachments', 'path', r.storage_path, 'op', 'move', 'to', v_to));
      update public.customer_request_attachments
         set profile_id = null, storage_path = v_to, file_name = 'attachment' || v_ext
       where id = r.id;
    end loop;
    v_counts := v_counts || jsonb_build_object('storage.objects', jsonb_array_length(v_storage));

    -- 9.4 RETAIN-DETACHED (legal hold; link removed, free text scrubbed)
    perform set_config('lm.privacy_erasure_subject', p_user::text, true);
    update public.privacy_consent_events
       set user_id = null, erased_subject_id = v_tomb, erased_at = v_month
     where user_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('privacy_consent_events', v_n);
    perform set_config('lm.privacy_erasure_subject', '', true);

    update public.personal_data_disclosures set worker_user_id = null, metadata = null where worker_user_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('personal_data_disclosures', v_n);

    update public.journal_entries set worker_id = null where id = any (v_keep) and worker_id = any (v_workers);
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('journal_entries.retained', v_n);
    update public.journal_entry_work_items set worker_id = null
     where journal_entry_id = any (v_keep) and worker_id = any (v_workers);

    update public.engagement_contexts set profile_id = null, description = null, ended_note = null
     where id = any (v_ctx) and profile_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('engagement_contexts.retained', v_n);

    update public.customer_requests
       set profile_id = null,
           notes = case when payload->>'source' = 'privacy_self_service' then null else notes end,
           payload = public.privacy_erasure_scrub_jsonb(payload, v_ids,
                       case when payload->>'source' = 'privacy_self_service'
                            then array['email','full_name','phone','contact','contact_email','contact_phone','notes']
                            else array['email','full_name','phone','contact','contact_email','contact_phone'] end)
     where id = any (v_kept_req) and profile_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('customer_requests.retained', v_n);

    update public.booking_requests set worker_id = null, readiness_snapshot = '{}'::jsonb
     where worker_id = any (v_workers);
    update public.company_worker_engagements set worker_id = null, subject_key = gen_random_uuid()
     where worker_id = any (v_workers);
    delete from public.asset_assignments where worker_id = any (v_workers) and project_id is null;
    update public.asset_assignments set worker_id = null where worker_id = any (v_workers);
    update public.worker_absences set worker_id = null, note = null where worker_id = any (v_workers);
    update public.performance_reviews set subject_profile_id = null, worker_input = null where subject_profile_id = p_user;
    update public.usage_cost_events
       set profile_id = null, session_id = null,
           workspace_id = case when workspace_id = any (v_ids) then null else workspace_id end,
           metadata = metadata - 'request_context'
     where profile_id = p_user or workspace_id = any (v_ids);

    -- 9.5 PSEUDONYMISE specials
    update public.ai_runs set profile_id = null, output_excerpt = null, request_context = null where profile_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('ai_runs', v_n);

    update public.audit_logs a
       set payload = public.privacy_erasure_scrub_jsonb(a.payload, v_ids,
                       case when a.actor_id = p_user or a.entity_id::text = any (v_ids)
                            then array['display_name','full_name','email','phone','invited_email']
                            else '{}'::text[] end),
           actor_id  = case when a.actor_id = p_user then null else a.actor_id end,
           entity_id = case when a.entity_id::text = any (v_ids) then null else a.entity_id end
     where a.actor_id = p_user or a.entity_id::text = any (v_ids) or a.payload::text like any (v_like);
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('audit_logs', v_n);

    -- G6: threads nobody else is in disappear; in shared threads the person's
    -- messages lose author AND words (the other party keeps their own side)
    delete from public.conversations c
     where c.created_by = p_user
       and not exists (select 1 from public.conversation_participants p where p.conversation_id = c.id and p.profile_id <> p_user)
       and not exists (select 1 from public.conversation_messages m where m.conversation_id = c.id and m.author_id <> p_user);
    update public.conversation_messages
       set author_id = null, body = '', translated_text = null, original_language = null,
           target_language = null, translation_status = 'unavailable'
     where author_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('conversation_messages.redacted', v_n);
    update public.conversations set created_by = null where created_by = p_user;

    update public.invitations set status = 'revoked' where inviter_profile_id = p_user and status = 'pending';
    update public.invitations set inviter_profile_id = null where inviter_profile_id = p_user;
    update public.invitations
       set accepted_by_profile_id = null, invited_email = null, invited_name = null, personal_message = null
     where accepted_by_profile_id = p_user;
    if v_email is not null then
      update public.invitations
         set status = case when status = 'pending' then 'revoked' else status end,
             invited_email = null, invited_name = null, personal_message = null
       where lower(invited_email) = v_email;
      update public.agency_worker_invitations
         set invited_email = 'erased-' || gen_random_uuid()::text || '@erased.invalid',
             status = case when status = 'pending' then 'cancelled' else status end
       where lower(invited_email) = v_email;
      update public.company_worker_invitations
         set invited_email = 'erased-' || gen_random_uuid()::text || '@erased.invalid',
             status = case when status = 'pending' then 'cancelled' else status end
       where lower(invited_email) = v_email;
      update public.agency_client_connections
         set invited_email = 'erased-' || gen_random_uuid()::text || '@erased.invalid',
             status = case when status = 'pending' then 'revoked' else status end
       where lower(invited_email) = v_email;
      delete from public.waitlist where lower(email) = v_email;
      delete from public.leads where lower(email) = v_email;
      update public.company_need_public_intakes set contact_name = null, contact_email = null, contact_phone = null
       where lower(contact_email) = v_email;
    end if;

    -- G3: the organization's roster row stays (its history hangs off it) but
    -- stops naming the person
    update public.organization_people
       set linked_profile_id = null, linked_worker_id = null, link_state = 'unlinked',
           link_method = null, linked_at = null,
           display_name = 'Erased person',
           normalized_name = 'erased ' || substr(md5(gen_random_uuid()::text), 1, 12),
           source_note = null, external_ref = null
     where linked_profile_id = p_user or linked_worker_id = any (v_workers);
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('organization_people', v_n);

    -- G4: other recipients' notifications about the person
    update public.notification_events
       set entity_id = gen_random_uuid(), metadata = metadata - 'title'
     where entity_id::text = any (v_ids) and recipient_profile_id <> p_user;

    -- ids of the person inside surviving JSON (event states, metadata, payloads)
    for r in select * from (values
        ('agreement_events','before_state'), ('agreement_events','after_state'),
        ('org_document_events','before_state'), ('org_document_events','after_state'),
        ('training_assignment_events','before_state'), ('training_assignment_events','after_state'),
        ('worker_document_events','before_state'), ('worker_document_events','after_state'),
        ('work_task_events','before_state'), ('work_task_events','after_state'),
        ('engagement_lifecycle_events','metadata'), ('management_decision_events','metadata'),
        ('performance_review_events','metadata'), ('workflow_transitions','metadata'),
        ('booking_request_events','previous_terms'), ('evidence_import_events','payload'),
        ('learning_signals','proposed_outcome'), ('learning_review_queue','proposed_action'),
        ('workflow_instances','payload'), ('timesheets','lines_snapshot'),
        ('notification_events','metadata'), ('pilot_events','metadata'), ('usage_cost_events','metadata'),
        ('organization_evidence_records','source_fact'), ('organization_evidence_records','derived'),
        ('historical_consolidation_decisions','signals'), ('historical_consolidation_decisions','conflicts'),
        ('commitment_override_receipts','collisions'), ('document_acknowledgements','evidence'),
        ('invitations','declared_context'), ('invitations','consent_record')
      ) as t(tbl, col) loop
      execute format('update public.%I set %I = public.privacy_erasure_scrub_jsonb(%I, $1) where %I::text like any ($2)',
                     r.tbl, r.col, r.col, r.col)
        using v_ids, v_like;
    end loop;

    delete from public.pilot_events
     where profile_id = p_user
        or session_id in (select e.session_id from public.pilot_events e where e.profile_id = p_user);
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('pilot_events', v_n);

    if to_regclass('public.worker_display_name_backfill_20260805') is not null then
      delete from public.worker_display_name_backfill_20260805 where profile_id = p_user;
    end if;

    -- 9.6 generic: every registry column whose row survives -> link NULL
    for r in select x.table_name, x.column_name, x.ref_kind, x.class from public.privacy_erasure_relations x
              where x.mode = 'null' and x.class in ('PSEUDONYMISE','RETAIN','BLOCK')
              order by x.table_name, x.column_name loop
      execute format('update public.%I set %I = null where %I = any ($1)', r.table_name, r.column_name, r.column_name)
        using case when r.ref_kind = 'worker' then v_workers else array[p_user] end;
      get diagnostics v_n = row_count;
      if v_n > 0 then
        v_counts := v_counts || jsonb_build_object(r.table_name || '.' || r.column_name, v_n);
      end if;
    end loop;

    -- 9.7 generic: DELETE rows whose FK would not cascade
    for r in select x.table_name, x.column_name, x.ref_kind from public.privacy_erasure_relations x
              where x.mode = 'delete' and x.class = 'DELETE' loop
      execute format('delete from public.%I where %I = any ($1)', r.table_name, r.column_name)
        using case when r.ref_kind = 'worker' then v_workers else array[p_user] end;
    end loop;

    -- 9.8 ERASURE of the person: workers then profiles (cascades take every
    -- remaining DELETE-class row; an unhandled NO ACTION reference raises here
    -- and rolls the whole erasure back — never half-erased)
    delete from public.customer_requests where profile_id = p_user and not (id = any (v_kept_req));
    delete from public.workers where profile_id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('workers', v_n);
    delete from public.profiles where id = p_user;
    get diagnostics v_n = row_count; v_counts := v_counts || jsonb_build_object('profiles', v_n);

    -- Storage rows the person still owns but that are not deleted/moved
    -- (e.g. an organization's evidence photo they uploaded): drop ownership
    -- so auth.admin.deleteUser is not refused and the owner column names nobody.
    update storage.objects o set owner = null, owner_id = null
     where (o.owner = p_user or o.owner_id = p_user::text)
       and not exists (select 1 from jsonb_array_elements(v_storage) s
                        where s->>'bucket' = o.bucket_id and s->>'path' = o.name);

    -- 9.9 re-enable exactly the suspended triggers, then prove none is left off
    for i in 1 .. coalesce(array_length(v_dis_rel, 1), 0) loop
      execute format('alter table %s enable trigger %I', v_dis_rel[i], v_dis_tg[i]);
    end loop;
    if exists (select 1 from pg_catalog.pg_trigger t
                where t.tgenabled = 'D'
                  and (t.tgrelid, t.tgname) in (select u.rel::oid, u.tg
                                                  from unnest(v_dis_rel, v_dis_tg) as u(rel, tg))) then
      raise exception 'privacy_erasure_execute_v2: a guard trigger stayed disabled' using errcode = 'XX000';
    end if;

    update public.privacy_erasure_jobs
       set state = case when jsonb_array_length(v_storage) > 0 then 'storage_pending' else 'auth_pending' end,
           storage_ops = v_storage, blockers = '[]'::jsonb, executed_on = current_date,
           attempts = attempts + 1, last_error = null,
           report = report || jsonb_build_object('executed', v_counts)
     where id = p_job;

    return jsonb_build_object('job_id', p_job,
             'state', case when jsonb_array_length(v_storage) > 0 then 'storage_pending' else 'auth_pending' end,
             'storage_ops', v_storage, 'counts', v_counts);

  exception when others then
    get stacked diagnostics v_sqlstate = returned_sqlstate, v_table = table_name, v_constraint = constraint_name;
    update public.privacy_erasure_jobs
       set state = 'failed', attempts = attempts + 1,
           last_error = v_sqlstate || coalesce(' table=' || nullif(v_table, ''), '')
                                   || coalesce(' constraint=' || nullif(v_constraint, ''), '')
     where id = p_job;
    return jsonb_build_object('job_id', p_job, 'state', 'failed', 'sqlstate', v_sqlstate,
                              'table', nullif(v_table, ''), 'constraint', nullif(v_constraint, ''));
  end;
end;
$$;

-- ── 10. step 2: the server reports the Storage API work as done ─────────────
-- Verifies instead of trusting: every 'delete' path is gone, every 'move'
-- target exists and its source is gone, and the subject owns no object.
create or replace function public.privacy_erasure_storage_done_v2(p_job uuid)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_job public.privacy_erasure_jobs%rowtype;
  v_left bigint;
begin
  select * into v_job from public.privacy_erasure_jobs j where j.id = p_job for update;
  if not found then
    raise exception 'privacy_erasure_storage_done_v2: no such job' using errcode = 'P0002';
  end if;
  if v_job.state = 'auth_pending' then
    return jsonb_build_object('job_id', p_job, 'state', 'auth_pending', 'replayed', true);
  end if;
  if v_job.state <> 'storage_pending' then
    raise exception 'privacy_erasure_storage_done_v2: job state % is not storage_pending', v_job.state using errcode = '55000';
  end if;

  select count(*) into v_left
    from jsonb_array_elements(coalesce(v_job.storage_ops, '[]'::jsonb)) s
   where exists (select 1 from storage.objects o where o.bucket_id = s->>'bucket' and o.name = s->>'path')
      or (s->>'op' = 'move'
          and not exists (select 1 from storage.objects o where o.bucket_id = s->>'bucket' and o.name = s->>'to'));
  v_left := v_left + (select count(*) from storage.objects o
                       where o.owner = v_job.subject_user_id or o.owner_id = v_job.subject_user_id::text);
  if v_left > 0 then
    return jsonb_build_object('job_id', p_job, 'state', 'storage_pending', 'remaining', v_left);
  end if;

  update public.privacy_erasure_jobs set state = 'auth_pending' where id = p_job;
  return jsonb_build_object('job_id', p_job, 'state', 'auth_pending');
end;
$$;

-- ── 11. step 3: after auth.admin.deleteUser — close the job ─────────────────
-- Refuses while the auth user still exists. On completion the job forgets the
-- subject id and the object paths: what stays is request id (a detached
-- row), aggregate counts and coarse dates.
create or replace function public.privacy_erasure_complete_v2(p_job uuid)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_job public.privacy_erasure_jobs%rowtype;
begin
  select * into v_job from public.privacy_erasure_jobs j where j.id = p_job for update;
  if not found then
    raise exception 'privacy_erasure_complete_v2: no such job' using errcode = 'P0002';
  end if;
  if v_job.state = 'completed' then
    return jsonb_build_object('job_id', p_job, 'state', 'completed', 'replayed', true);
  end if;
  if v_job.state <> 'auth_pending' then
    raise exception 'privacy_erasure_complete_v2: job state % is not auth_pending', v_job.state using errcode = '55000';
  end if;
  if exists (select 1 from auth.users u where u.id = v_job.subject_user_id) then
    raise exception 'privacy_erasure_complete_v2: the auth user still exists; call auth.admin.deleteUser first'
      using errcode = '55000';
  end if;

  update public.privacy_erasure_jobs
     set state = 'completed', subject_user_id = null, storage_ops = null,
         completed_on = current_date,
         report = jsonb_build_object('executed', report->'executed')  -- drop the dry-run detail
   where id = p_job;
  return jsonb_build_object('job_id', p_job, 'state', 'completed');
end;
$$;

-- ── 12. grants: service_role only, behind the human-reviewed request flow ───
do $$
declare
  f text;
begin
  foreach f in array array[
    'public.privacy_erasure_prepare_v2(uuid)',
    'public.privacy_erasure_execute_v2(uuid, uuid)',
    'public.privacy_erasure_storage_done_v2(uuid)',
    'public.privacy_erasure_complete_v2(uuid)',
    'public.privacy_erasure_blockers_v2(uuid)',
    'public.privacy_erasure_guard_triggers_v2()',
    'public.privacy_erasure_scrub_jsonb(jsonb, text[], text[])'
  ] loop
    execute format('revoke all on function %s from public, anon, authenticated', f);
  end loop;
end;
$$;

grant execute on function public.privacy_erasure_prepare_v2(uuid)       to service_role;
grant execute on function public.privacy_erasure_execute_v2(uuid, uuid) to service_role;
grant execute on function public.privacy_erasure_storage_done_v2(uuid)  to service_role;
grant execute on function public.privacy_erasure_complete_v2(uuid)      to service_role;

comment on function public.privacy_erasure_execute_v2(uuid, uuid) is
  'GDPR Art. 17 erasure, DB part (#856 v2): retain-detached / pseudonymise / delete per privacy_erasure_relations in ONE transaction; returns Storage ops; never deletes auth.users (the server calls auth.admin.deleteUser last). service_role only.';

commit;
