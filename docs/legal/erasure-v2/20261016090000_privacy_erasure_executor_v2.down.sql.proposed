-- ROLLBACK for 20261016090000_privacy_erasure_executor_v2.sql
-- (supabase/rollbacks/20261016090000_privacy_erasure_executor_v2.down.sql)
--
-- REFUSES once any erasure has executed. Why: an executed erasure deleted
-- rows that cannot be restored, nulled links that must never be re-attached
-- (re-attaching would re-identify an erased person), and left NULLs in the
-- 99 columns this migration relaxed — `SET NOT NULL` would fail on them, and
-- the consent ledger holds detached rows the old CHECK-less shape cannot
-- represent. After the first executed erasure the only safe "rollback" is a
-- forward fix (a new migration), never this file.
--
-- Before any execution it restores exactly the pre-migration state: functions
-- and the two tables dropped, the consent-ledger trigger back to
-- unconditional refusal, the 8 CHECKs back to their production text, the 99
-- NOT NULLs back, and the consent detach columns removed.

begin;

do $$
begin
  if to_regclass('public.privacy_erasure_jobs') is not null and exists (
       select 1 from public.privacy_erasure_jobs
        where executed_on is not null or state in ('storage_pending','auth_pending','completed')) then
    raise exception 'rollback refused: an erasure has executed; ship a forward fix instead (see header)'
      using errcode = '55000';
  end if;
  if exists (select 1 from public.privacy_consent_events where user_id is null) then
    raise exception 'rollback refused: detached consent-ledger rows exist' using errcode = '55000';
  end if;
end;
$$;

drop function if exists public.privacy_erasure_complete_v2(uuid);
drop function if exists public.privacy_erasure_storage_done_v2(uuid);
drop function if exists public.privacy_erasure_execute_v2(uuid, uuid);
drop function if exists public.privacy_erasure_prepare_v2(uuid);
drop function if exists public.privacy_erasure_blockers_v2(uuid);
drop function if exists public.privacy_erasure_guard_triggers_v2();
drop function if exists public.privacy_erasure_scrub_jsonb(jsonb, text[], text[]);
drop table if exists public.privacy_erasure_jobs;
drop table if exists public.privacy_erasure_relations;

create or replace function public.privacy_ledger_block_mutation()
returns trigger
language plpgsql
set search_path = public
as $$
begin
  raise exception 'privacy ledger is append-only: % on % is not allowed', tg_op, tg_table_name
    using errcode = 'raise_exception';
end;
$$;

alter table public.privacy_consent_events drop constraint if exists pce_subject_attached_or_detached;
alter table public.privacy_consent_events drop column if exists erased_subject_id;
alter table public.privacy_consent_events drop column if exists erased_at;
alter table public.privacy_consent_events alter column user_id set not null;

-- the 8 CHECKs, production text 2026-10-15
alter table public.workflow_instance_approvers drop constraint if exists workflow_instance_approvers_decided_shape;
alter table public.workflow_instance_approvers add constraint workflow_instance_approvers_decided_shape check ((((decision IS NULL) AND (decided_by IS NULL) AND (decided_at IS NULL)) OR ((decision IS NOT NULL) AND (decided_by IS NOT NULL) AND (decided_at IS NOT NULL))));
alter table public.onboarding_run_items drop constraint if exists onboarding_run_items_done_shape;
alter table public.onboarding_run_items add constraint onboarding_run_items_done_shape check ((((status = 'pending'::text) AND (completed_by IS NULL) AND (completed_at IS NULL)) OR ((status = ANY (ARRAY['done'::text, 'skipped'::text])) AND (completed_by IS NOT NULL) AND (completed_at IS NOT NULL))));
alter table public.offboarding_run_items drop constraint if exists offboarding_run_items_done_shape;
alter table public.offboarding_run_items add constraint offboarding_run_items_done_shape check ((((status = 'pending'::text) AND (completed_by IS NULL) AND (completed_at IS NULL)) OR ((status = ANY (ARRAY['done'::text, 'skipped'::text])) AND (completed_by IS NOT NULL) AND (completed_at IS NOT NULL))));
alter table public.performance_reviews drop constraint if exists performance_reviews_manager_input_stamp;
alter table public.performance_reviews add constraint performance_reviews_manager_input_stamp check ((((manager_input IS NULL) = (manager_input_at IS NULL)) AND ((manager_input IS NULL) = (manager_input_by IS NULL))));
alter table public.organization_claims drop constraint if exists organization_claims_decision_complete;
alter table public.organization_claims add constraint organization_claims_decision_complete check (((state <> ALL (ARRAY['representative_verified'::text, 'linked'::text])) OR ((decided_by IS NOT NULL) AND (decided_at IS NOT NULL) AND (verification_method IS NOT NULL) AND (verification_evidence_ref IS NOT NULL))));
alter table public.work_counterparty_links drop constraint if exists work_counterparty_links_revocation_shape;
alter table public.work_counterparty_links add constraint work_counterparty_links_revocation_shape check (((revoked_at IS NULL) = (revoked_by IS NULL)));
alter table public.document_acknowledgements drop constraint if exists document_acknowledgements_stamp_pair;
alter table public.document_acknowledgements add constraint document_acknowledgements_stamp_pair check (((acknowledged_at IS NULL) = (acknowledged_by IS NULL)));
alter table public.invitations drop constraint if exists invitations_origin_chk;
alter table public.invitations add constraint invitations_origin_chk check ((((inviter_profile_id IS NOT NULL) AND (external_source_slug IS NULL) AND (external_reference IS NULL)) OR ((inviter_profile_id IS NULL) AND (external_source_slug IS NOT NULL) AND (external_reference IS NOT NULL) AND (consent_record IS NOT NULL))));

