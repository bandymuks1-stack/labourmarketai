     expect(entryLocaleForUnmatchedLanguage("de-AT", null)).toBeNull();
     expect(entryLocaleForUnmatchedLanguage("ru-RU", null)).toBeNull();
   });
+  it("a routed language refused with q=0 is not a routed match (RFC 9110 §12.4.2)", () => {
+    expect(entryLocaleForUnmatchedLanguage("sv-SE,de;q=0", null)).toBe("en");
+    expect(entryLocaleForUnmatchedLanguage("sv-SE,sv;q=0.9,en;q=0,lt;q=0.0", null)).toBe("en");
+    // a refused language alone states no preference — the default stands
+    expect(entryLocaleForUnmatchedLanguage("de;q=0", null)).toBeNull();
+    // a weighted routed language still counts
+    expect(entryLocaleForUnmatchedLanguage("sv-SE,en;q=0.1", null)).toBeNull();
+  });
