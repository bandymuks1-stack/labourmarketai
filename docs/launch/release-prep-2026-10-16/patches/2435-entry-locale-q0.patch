diff --git a/apps/web/lib/i18n/entry-locale.ts b/apps/web/lib/i18n/entry-locale.ts
index 36b2725..43776c2 100644
--- a/apps/web/lib/i18n/entry-locale.ts
+++ b/apps/web/lib/i18n/entry-locale.ts
@@ -27,11 +27,27 @@ export function entryLocaleForUnmatchedLanguage(
   if (!header) return null;
   let stated = 0;
   for (const part of header.split(",")) {
-    const tag = part.split(";")[0]?.trim().toLowerCase();
+    const [rawTag, ...params] = part.split(";");
+    const tag = rawTag?.trim().toLowerCase();
     if (!tag || tag === "*") continue;
+    // RFC 9110 §12.4.2: `q=0` means NOT acceptable. A language the browser
+    // explicitly refuses is neither a stated preference nor a routed match —
+    // `sv-SE,de;q=0` must still land on English, not on German's negotiation.
+    if (qualityOf(params) === 0) continue;
     stated += 1;
     const base = tag.split("-")[0];
     if (routed.includes(base)) return null;
   }
   return stated > 0 ? UNSUPPORTED_LANGUAGE_FALLBACK : null;
 }
+
+/** The `q` weight of one Accept-Language range; 1 when absent or unparseable. */
+function qualityOf(params: readonly string[]): number {
+  for (const param of params) {
+    const [key, value] = param.split("=").map((piece) => piece.trim().toLowerCase());
+    if (key !== "q") continue;
+    const q = Number(value);
+    return Number.isFinite(q) ? q : 1;
+  }
+  return 1;
+}
