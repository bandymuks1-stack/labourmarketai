  * derives it so the queue can show it and sort by it. Extensions (Art.
  * 12(3), up to two further months for complex requests) are a human
  * decision recorded in the review note — never computed here.
+ *
+ * "One month" is a CALENDAR month, not 30 days (review finding on #2436;
+ * EDPB Guidelines 01/2022 on the right of access, §5.1): the deadline is the
+ * same day of the following month — 5 March → 5 April — and, when that day
+ * does not exist, the last day of that month — 31 August → 30 September. A
+ * deadline that lands on a Saturday or Sunday moves to the next Monday.
+ * Public holidays are jurisdiction-specific and stay a human reading in the
+ * review note; the computed date is never later than the statutory one.
  */
 
-export const DSR_RESPONSE_DAYS = 30;
+const DAY_MS = 24 * 60 * 60 * 1000;
 
-/** ISO instant of the statutory one-month response deadline. */
+/** ISO instant of the statutory one-month response deadline (UTC calendar). */
 export function dsrDueAtIso(createdAtIso: string): string {
   const created = new Date(createdAtIso);
   if (Number.isNaN(created.getTime())) return createdAtIso;
-  return new Date(created.getTime() + DSR_RESPONSE_DAYS * 24 * 60 * 60 * 1000).toISOString();
+  const year = created.getUTCFullYear();
+  const month = created.getUTCMonth();
+  const lastDayOfNextMonth = new Date(Date.UTC(year, month + 2, 0)).getUTCDate();
+  let due = new Date(
+    Date.UTC(
+      year,
+      month + 1,
+      Math.min(created.getUTCDate(), lastDayOfNextMonth),
+      created.getUTCHours(),
+      created.getUTCMinutes(),
+      created.getUTCSeconds(),
+      created.getUTCMilliseconds(),
+    ),
+  );
+  const weekday = due.getUTCDay();
+  if (weekday === 6) due = new Date(due.getTime() + 2 * DAY_MS);
+  else if (weekday === 0) due = new Date(due.getTime() + DAY_MS);
+  return due.toISOString();
 }
 
 /** True when the deadline has passed and the request is still open. */
