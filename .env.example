NEXT_PUBLIC_SUPABASE_URL=https://gorgitwvdzxbnaxhrsrw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from Supabase Dashboard → Settings → API>
SUPABASE_SERVICE_ROLE_KEY=<paste from Supabase Dashboard → Settings → API, NEVER commit>
SUPABASE_DB_PASSWORD=<from Supabase Dashboard → Settings → Database, NEVER commit>
NEXT_PUBLIC_SHOW_PLACEHOLDER_MARKERS=true

# ── Billing (Stripe TEST mode only — live is hard-blocked in code) ───────────
# Payments are OFF unless ALL of these are set with a valid TEST config.
# NEVER commit real values. Set in Vercel env / .env.local only.
# A live key (sk_live_/pk_live_) or STRIPE_MODE=live is rejected by the config
# and fails the no-live-payments guard — by design.
PAYMENTS_ENABLED=false
BILLING_PROVIDER=none
STRIPE_MODE=test
STRIPE_SECRET_KEY=<sk_test_... from Stripe Dashboard (TEST mode), NEVER commit>
STRIPE_WEBHOOK_SECRET=<whsec_... from `stripe listen` or the test webhook endpoint>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_... (TEST publishable key)>
STRIPE_PRICE_WORKER_PLUS=<price_... TEST price id for Worker Plus>
STRIPE_PRICE_COMPANY_PILOT=<price_... TEST price id for Company Pilot>
STRIPE_PRICE_AGENCY_PILOT=<price_... TEST price id for Agency Pilot>
# Google Maps base map for /dashboard/market-map (browser key).
# OPTIONAL: when unset, the market map shows an honest "config needed" fallback
# (never fake tiles, never fake markers). Restrict the key to your domains in the
# Google Cloud console. NEVER commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Internal AI agents / provider router (ALL OFF by default) ────────────────
# The AI runtime is `disabled` unless AI_PROVIDER_MODE is `mock` (tests/dev,
# no network) or `live`. `live` additionally requires a real key for the
# selected provider. Model choice stays in the routing layer (cheapest
# sufficient tier — the max model is never a default). Server env only —
# NEVER commit real keys, NEVER NEXT_PUBLIC. Docs:
# docs/product/ai-provider-router-v1.md
AI_PROVIDER_MODE=disabled
# Primary provider for live runs: anthropic | openai | gemini | xai
AI_PROVIDER=anthropic
# Anthropic key (used when AI_PROVIDER=anthropic; also the generic fallback).
AI_API_KEY=<sk-ant-... Anthropic API key, NEVER commit>
# Optional default model override (routing normally supplies the model id).
AI_MODEL=
# Cost/safety guards (clamped in code; safe defaults apply when unset).
AI_REQUEST_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_MAX_OUTPUT_TOKENS=
# Persisted daily run budget — enforced against the ai_runs counter once the
# gated ai_runs migration is applied; over budget → honest block.
AI_DAILY_RUN_BUDGET=
# Per-provider adapters — DOUBLE gated: enable flag must be true AND the key
# must be present, else the adapter stays inert (honest disabled result).
AI_OPENAI_ENABLED=false
OPENAI_API_KEY=<sk-... OpenAI API key, NEVER commit>
AI_GEMINI_ENABLED=false
GEMINI_API_KEY=<Google AI Studio key, NEVER commit>
AI_XAI_ENABLED=false
XAI_API_KEY=<xAI API key, NEVER commit>
# DeepL serves ONLY the translate_message task (language routing preference);
# when unset/off, the low-cost LLM tier translates exactly as before.
AI_DEEPL_ENABLED=false
DEEPL_API_KEY=<DeepL API key (":fx" suffix = free plan), NEVER commit>

# Local OpenAI-compatible runtime — the FIRST provider the chain tries, and the
# only one that needs NO key: it authenticates by network location, not by a
# secret. Do NOT invent a placeholder key for it; a fake secret looks like
# configuration and proves nothing. Its proof of configuration is instead the
# base URL AND the model id, both required and both validated.
#
# Works with any server speaking /v1/chat/completions (Ollama's compatible API,
# LM Studio, vLLM, llama.cpp) — no product is hard-coded. The /v1 suffix is
# optional. Plaintext http is accepted ONLY for a loopback host; a runtime on
# another machine must use https, because these prompts carry CVs and journal
# text. Setup + the privacy rationale: docs/ai/local-runtime-setup.md
AI_LOCAL_ENABLED=false
AI_LOCAL_BASE_URL=<e.g. http://localhost:11434/v1>
AI_LOCAL_MODEL=<the model id your server actually hosts, e.g. llama3.1:8b>
# OPTIONAL — only for a local runtime behind a proxy that wants a bearer token.
# Leaving this unset is the normal, supported case.
AI_LOCAL_API_KEY=<optional proxy bearer token, NEVER commit>

# ── Owner Telegram alerts (server-only demand-signal notifications) ──────────
# Best-effort owner alert when a public /company-need intake is persisted.
# OFF by default. Set ALL three (server env only — NEVER commit, NEVER
# NEXT_PUBLIC) to enable. Bot token from @BotFather; chat id is the owner's
# private chat/user id. If unset, the public submit works exactly as before and
# no alert is sent.
OWNER_TELEGRAM_ALERTS_ENABLED=false
OWNER_TELEGRAM_BOT_TOKEN=<bot token from @BotFather, NEVER commit>
OWNER_TELEGRAM_CHAT_ID=<owner private chat id, NEVER commit>

# ── Agentai OS owner-alert bridge (PREFERRED — reuses the existing Agentai OS
# Telegram owner channel, so no separate bot is needed here) ─────────────────
# When enabled, a persisted /company-need intake POSTs a JSON event to the
# owner's Agentai OS alert endpoint (bearer shared-secret); Agentai OS formats +
# sends it via its existing owner Telegram channel. Server env only — NEVER
# commit, NEVER NEXT_PUBLIC. Requires the owner to deploy a PUBLIC HTTPS Agentai
# OS bridge (Vercel cannot reach a local machine). See
# docs/launch/owner-alert-agentai-os-bridge-plan-v1.md. Takes priority over the
# standalone Telegram vars above; if unset, that fallback (or a no-op) applies.
AGENTAI_OS_ALERTS_ENABLED=false
AGENTAI_OS_ALERT_ENDPOINT=<https URL of the deployed Agentai OS bridge>
AGENTAI_OS_ALERT_TOKEN=<shared secret the bridge validates, NEVER commit>

# ── Invitation email delivery (core-network area B) — OWNER GATE ─────────────
# OFF by default: with these unset, "Pakviesti" stores the invitation and
# hands the inviter a shareable link (copy / native share) — no email is ever
# attempted and nothing is shown as "sent". To activate real invitation
# emails the owner must: (1) pick a transactional provider ('resend' or
# 'postmark'), (2) create the API key, (3) verify the labourmarket.ai sending
# domain (SPF + DKIM) at that provider, (4) set all three vars in Vercel
# (server env only — NEVER commit, NEVER NEXT_PUBLIC), (5) approve one
# owner-reviewed test send. The adapter marks an invitation "sent" ONLY when
# the provider's API acknowledged the message; provider names never reach
# the UI.
# Notifications completion v1: the SAME three vars also gate the notification
# email dispatcher (lib/notifications/email-dispatch.ts) — setting a real
# provider turns on notification emails for people who explicitly opted in
# per type on /dashboard/account (email default is OFF, consent-first).
# Dev/test only: INVITE_EMAIL_PROVIDER=log exercises the whole email path
# without vendor keys (rendered emails go to the server log, tagged "logged",
# never claimed as sent); the log provider is ignored in production.
INVITE_EMAIL_PROVIDER=
INVITE_EMAIL_API_KEY=<transactional provider API key, NEVER commit>
INVITE_EMAIL_FROM=<verified sender, e.g. "LabourMarket.ai <invites@labourmarket.ai>">

# ── Scheduled jobs (notifications completion v1) — OWNER GATE ────────────────
# Shared secret for /api/cron/weekly-digest (Vercel cron sends it as
# "Authorization: Bearer <CRON_SECRET>" automatically once set in Vercel).
# While unset the route refuses 401 unconditionally — the weekly-digest sweep
# stays inert and only the read-time emitter runs.
CRON_SECRET=<random secret for Vercel cron auth, NEVER commit>
