NEXT_PUBLIC_SUPABASE_URL=https://gorgitwvdzxbnaxhrsrw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from Supabase Dashboard → Settings → API>
SUPABASE_SERVICE_ROLE_KEY=<paste from Supabase Dashboard → Settings → API, NEVER commit>
SUPABASE_DB_PASSWORD=<from Supabase Dashboard → Settings → Database, NEVER commit>
NEXT_PUBLIC_SHOW_PLACEHOLDER_MARKERS=true

# ── Billing (Stripe TEST mode only — live is hard-blocked in code) ───────────
# Payments are OFF unless ALL of these are set with a valid TEST config.
# NEVER commit real values. Set in Vercel env / .env.local only.
# A live key (sk_live_/pk_live_) or STRIPE_MODE=live is rejected by the config
# and fails the no-live-payments guard — by design.
PAYMENTS_ENABLED=false
BILLING_PROVIDER=none
STRIPE_MODE=test
STRIPE_SECRET_KEY=<sk_test_... from Stripe Dashboard (TEST mode), NEVER commit>
STRIPE_WEBHOOK_SECRET=<whsec_... from `stripe listen` or the test webhook endpoint>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_... (TEST publishable key)>
STRIPE_PRICE_WORKER_PLUS=<price_... TEST price id for Worker Plus>
STRIPE_PRICE_COMPANY_PILOT=<price_... TEST price id for Company Pilot>
STRIPE_PRICE_AGENCY_PILOT=<price_... TEST price id for Agency Pilot>
