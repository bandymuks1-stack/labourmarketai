# Required — 32+ character random secret shared with the web app
# (generate: openssl rand -hex 32). The web app sends it as
# Authorization: Bearer <token>.
TRANSCRIBE_TOKEN=

# Model built into the image: tiny | base | small | medium | large-v3-turbo
WHISPER_MODEL=small

# Optional overrides
MAX_BODY_BYTES=26214400
MAX_DURATION_SECONDS=600
WHISPER_THREADS=4
RATE_LIMIT_PER_MINUTE=10
