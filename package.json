{
  "name": "labourmarket-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -C apps/web typecheck",
    "format": "pnpm -C apps/web format",
    "placeholders:list": "pnpm -C apps/web placeholders:list",
    "placeholders:pending": "pnpm -C apps/web placeholders:pending",
    "placeholders:check": "pnpm -C apps/web placeholders:check",
    "placeholders:promote": "pnpm -C apps/web placeholders:promote",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id gorgitwvdzxbnaxhrsrw --schema public > apps/web/lib/supabase/types.ts",
    "db:fixtures:local": "pnpm -C apps/web db:fixtures:local",
    "admin:promote": "pnpm -C apps/web admin:promote"
  },
  "devDependencies": {
    "supabase": "^2.100.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["supabase"]
  }
}
