# Backup watchdog: unprivileged user, no Linux capabilities, no database access. Reads only the encrypted
# backups (through group lmwatch) and its own folder. Exit 1 means a problem it has already reported.
[Unit]
Description=LabourMarket backup watchdog

[Service]
Type=oneshot
User=lmwatch
Group=lmwatch
UMask=0077
StateDirectory=lm-watch
StateDirectoryMode=0700
ExecStart=/bin/sh /opt/lm-watch/lm-backup-watchdog.sh --root /var/lib/lm-watch
SuccessExitStatus=1
# The journal, never a file in the service user's own folder: systemd opens those as root and follows links.
StandardOutput=journal
StandardError=journal
BindReadOnlyPaths=/root/lm-prod/backups:/var/lib/lm-watch/backups
BindReadOnlyPaths=/opt/lm-watch
# Other apps may keep world-readable files here. The rest of the host: see the pre-install check in the runbook.
TemporaryFileSystem=/opt:ro /srv:ro /mnt:ro /media:ro
# The app's internal routes on this host and cloud metadata are off limits; the local DNS stub stays reachable.
IPAddressDeny=localhost link-local
IPAddressAllow=127.0.0.53
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=128M
TimeoutStartSec=15min
