# SEO watch: its own unprivileged user, because it parses content from the internet. It is not in group lmwatch
# and has no view of the backups. No Linux capabilities, no database access.
[Unit]
Description=LabourMarket SEO watch

[Service]
Type=oneshot
User=lmseo
Group=lmseo
UMask=0077
StateDirectory=lm-seo
StateDirectoryMode=0700
ExecStart=/bin/sh /opt/lm-watch/lm-seo-watch.sh --root /var/lib/lm-seo
SuccessExitStatus=1
StandardOutput=append:/var/lib/lm-seo/seo-watch.log
StandardError=append:/var/lib/lm-seo/seo-watch.log
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
Nice=19
CPUQuota=50%
MemoryMax=128M
TimeoutStartSec=15min
