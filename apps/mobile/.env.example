# LabourMarket.ai mobile — PUBLIC configuration only.
#
# Everything EXPO_PUBLIC_* is INLINED INTO THE SHIPPED BUNDLE. A device build
# cannot hold a secret: the binary is on the user's phone and cannot be edited
# afterwards. Never add a service-role key, a Stripe secret, an AI provider key
# or a database password here — @labourmarket/client-core refuses an
# RLS-bypassing key at startup, but the only real protection is not putting one
# in the file.
#
# Copy to .env.local (git-ignored) to run locally.

# Supabase project URL — public by design.
EXPO_PUBLIC_SUPABASE_URL=https://gorgitwvdzxbnaxhrsrw.supabase.co

# Anon / publishable key — public by design. RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the canonical LabourMarket.ai API. Configured now, unused until the
# owner-gated bearer transport lands (docs/APP_READINESS_MAP.md §5.1).
EXPO_PUBLIC_API_BASE_URL=https://labourmarket.ai
