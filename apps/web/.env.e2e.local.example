# Local E2E overrides — OPTIONAL.
#
# You normally need NONE of this. The local test helpers
# (`scripts/e2e-mint-session.ts`, `scripts/db-fixtures-local.ts`,
# `scripts/e2e-local.ts`) resolve the running local stack automatically via
# `npx supabase status -o env`.
#
# WHY A SEPARATE FILE. `apps/web/.env.local` points at the PRODUCTION Supabase
# project and holds a real service-role key — that is what `pnpm dev` needs.
# The test helpers therefore DO NOT read `.env.local` at all; if they did, a
# local test run would target production. Copy this file to `.env.e2e.local`
# only when you need to point the helpers at a non-default local stack (for
# example a second stack on a different machine port).
#
# Every value below is still validated by `lib/testing/local-supabase-guard.ts`.
# A non-loopback host, a `supabase.co` URL, the production project ref, a
# non-allowlisted origin, or any Supabase Cloud key is REFUSED with
# REFUSED_NON_LOCAL_E2E_SESSION_MINT. You cannot use this file to reach
# production, by design.
#
# These are the publicly-documented shared local-dev defaults printed by
# `npx supabase status`. They are not secrets and are identical on every
# machine. NEVER paste a cloud key here.

# Must be exactly http://127.0.0.1:54321 or http://localhost:54321.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=<paste ANON_KEY from `npx supabase status -o env`>
E2E_SUPABASE_SERVICE_ROLE_KEY=<paste SERVICE_ROLE_KEY from `npx supabase status -o env`>

# The LOCAL fixture user the Playwright session is minted for.
# Created by supabase/dev-fixtures.sql. Never a production account.
E2E_OWNER_EMAIL=dev.worker@local.test
